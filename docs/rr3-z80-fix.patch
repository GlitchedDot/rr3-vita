+/* Advance the Z80 by one scanline slice OUTSIDE the raster loop. For the
+ * atomic interrupt-delivery path (glue.c own_deliver_vint / own_deliver_hint):
+ * while a handler runs atomically the scanline scheduler is frozen, so a
+ * handler that releases the Z80 bus and then polls a Z80 handshake byte
+ * (RR3's sound-command enqueue spinning on driver RAM +0x0B) can never see
+ * the byte change — on hardware the Z80 executes concurrently and clears
+ * the flag within ~100 cycles. glue.c calls this on each bus-request
+ * release write inside atomic handler service so the Z80 makes the same
+ * progress it would on hardware while the 68K waits. step_z80 self-gates
+ * on busreq/reset, so calls made while the Z80 is halted are no-ops. */
+void machine_step_z80_scanline(void)
+{
+    step_z80(&g_machine, Z80_PER_LINE);
+}
