diff -ruN a/runner/glue.c b/runner/glue.c
--- a/runner/glue.c	2026-10-16 04:23:52.700426409 +0000
+++ b/runner/glue.c	2026-10-16 04:23:58.446426632 +0000
@@ -1720,6 +1720,21 @@
         g_mem_write_trace_fn(byte_addr + 1u, (uint8_t)val,        g_audio_cycle_counter);
     }
     gbus_write16(&g_machine.bus, byte_addr, val);
+    /* [Z80-SERVICE] Atomic interrupt service (s_in_vblank_service) runs the
+     * handler with every fiber yield gated and the scanline scheduler
+     * frozen, so the Z80 cannot advance at all while the handler runs.
+     * A handler that releases the Z80 bus and then spins on a Z80
+     * handshake byte — RR3's VBlank sound tick enqueueing a command while
+     * the driver is mid-consume (Z80 RAM +0x0B busy flag) — deadlocks:
+     * the flag can only clear if the Z80 executes, and it never does.
+     * On hardware the Z80 runs concurrently with the handler. Mirror
+     * that here: each bus-request RELEASE inside atomic service steps
+     * the Z80 one scanline slice (step_z80 self-gates while the bus is
+     * requested or reset is held, so this only ever gives the Z80 the
+     * cycles hardware would have given it). Outside atomic service the
+     * scheduler already paces the Z80; do not double-step there. */
+    if (s_in_vblank_service && byte_addr == 0xA11100u && !(val & 0x100u))
+        machine_step_z80_scanline();
 }
 
