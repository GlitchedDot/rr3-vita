diff -ruN a/runner/glue.c b/runner/glue.c
--- a/runner/glue.c	2026-10-16 04:24:09.483715940 +0000
+++ b/runner/glue.c	2026-10-16 05:23:18.364564793 +0000
@@ -1615,7 +1615,26 @@
     bus_ring_push(byte_addr, 1);
     spin_check(byte_addr, 0);
     HYBRID_BUMP_CYCLES();
-    return gbus_read16(&g_machine.bus, byte_addr);
+    uint16_t result = gbus_read16(&g_machine.bus, byte_addr);
+    /* [RASTER-SERVICE] Atomic interrupt service (s_in_vblank_service) runs
+     * the handler with every fiber yield gated and the scanline scheduler
+     * frozen, so the VDP raster cannot advance while the handler runs —
+     * the HV counter is computed from the scheduler's scanline state. A
+     * handler that polls the HV counter waiting for the beam to reach a
+     * target line/position — RR3's HBlank raster-split upload (wait for
+     * line, wait for hblank, wait for exact HV word) — deadlocks: the
+     * counter can only move if the scheduler runs, and it never does. On
+     * hardware the beam sweeps concurrently with the handler and the wait
+     * resolves within a few lines.
+     * Mirror that here: each HV-counter read
+     * inside atomic service advances the raster one observable phase
+     * (active -> hblank -> next line) after the read samples the current
+     * position, so a poll loop sees the same forward progress hardware
+     * gives it. Outside atomic service the scheduler paces the raster;
+     * do not double-advance there. */
+    if (s_in_vblank_service && byte_addr >= 0xC00008u && byte_addr <= 0xC0000Fu)
+        machine_advance_raster_phase();
+    return result;
 }
 
