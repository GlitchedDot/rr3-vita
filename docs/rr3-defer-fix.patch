 /* Re-entrancy guard (used by glue_check_vblank, must be in global scope) */
 static int s_in_vblank_service = 0;
 
+/* [DEFER-VDP] Deferred VDP-write visibility for atomic H-int service.
+ * The raster-split handler this exists for (RR3's HBlank engine) waits
+ * on the HV counter for its target line and only THEN uploads: on
+ * hardware the upload lands at the target line and affects rendering
+ * from that line on. Atomic delivery runs the whole handler at the
+ * delivery line, so an immediate write lands at the delivery line
+ * instead — every split point sits displaced by its wait length and
+ * the seam wobbles as the waits vary (the horizon band).
+ * While the level-4 branch services a handler (s_hint_service), VDP
+ * port writes ($C00000-$C00007: data + control) are queued with a
+ * stamp = the fake-raster line at write time (fix #2's phase machine
+ * has advanced vdp.scanline to exactly the line the handler waited
+ * for). machine_run_frame flushes the queue in FIFO order just
+ * before a line renders, applying every write stamped at or before
+ * that line, and flushes the remainder at frame end — so end-of-frame
+ * VDP state is unchanged and only the intra-frame visibility moves.
+ * Replays go through gbus_write16/8, so control-port command
+ * assembly, address auto-increment and DMA triggers all execute at
+ * apply time in the original order. Reads are never deferred. */
+static int s_hint_service = 0;
+typedef struct { uint32_t addr; uint16_t val; uint16_t stamp; uint8_t is8; } DVDPWrite;
+static DVDPWrite s_dvdp[8192];
+static int s_dvdp_count = 0;
+static unsigned long s_dvdp_overflow = 0;
+
+static int dvdp_try_queue(uint32_t addr, uint16_t val, int is8)
+{
+    if (!s_hint_service) return 0;
+    if (addr < 0xC00000u || addr >= 0xC00008u) return 0;
+    if (s_dvdp_count >= (int)(sizeof s_dvdp / sizeof s_dvdp[0])) { s_dvdp_overflow++; return 0; }
+    s_dvdp[s_dvdp_count].addr  = addr;
+    s_dvdp[s_dvdp_count].val   = val;
+    s_dvdp[s_dvdp_count].stamp = (uint16_t)g_machine.vdp.scanline;
+    s_dvdp[s_dvdp_count].is8   = (uint8_t)is8;
+    s_dvdp_count++;
+    return 1;
+}
+
+void glue_deferred_vdp_flush(int upto_line)
+{
+    int n = 0;
+    while (n < s_dvdp_count && (int)s_dvdp[n].stamp <= upto_line) {
+        if (s_dvdp[n].is8) gbus_write8(&g_machine.bus, s_dvdp[n].addr, (uint8_t)s_dvdp[n].val);
+        else               gbus_write16(&g_machine.bus, s_dvdp[n].addr, s_dvdp[n].val);
+        n++;
+    }
+    if (n) {
+        s_dvdp_count -= n;
+        memmove(s_dvdp, s_dvdp + n, (size_t)s_dvdp_count * sizeof s_dvdp[0]);
+    }
+}
+
+void glue_deferred_vdp_flush_all(void) { glue_deferred_vdp_flush(0x3FFFFFFF); }
+
